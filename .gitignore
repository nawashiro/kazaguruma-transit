# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/artifacts/lighthouse/

# next.js
/.next/
/out/

# generated location artifact
/public/generated/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temp
prisma/.temp/
.docs/

# transit
/transit-config.json

.gtfs/
.codex/
.claude/

# common local/editor artifacts
/.hermes/
dist/
*.tmp
*.swp
Thumbs.db
.vscode/
.idea/

# geocode index build cache
/data/.cache/

# generated geocode index (tracked separately in a follow-up change)
/data/geocode-index.json

# config
app-config.json
app-config.local.json

/src/generated/prisma/
/.jest/
/nohup.out

